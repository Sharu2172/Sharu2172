---
import { GradientBackground } from "../components/GradientBackground";
import Footer from "../components/Footer.astro";
import '../styles/global.css';

interface Props {
  showNav?: boolean;
  navRefId: string;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="D Sharath - Data Engineer & Backend Developer.">
    <meta name="keywords" content="D Sharath, Data Engineer, Backend Developer, Python, SQL, Data Pipelines, ETL, Big Data">
    <title>D Sharath - Data Engineer & Backend Developer</title>

    <!-- Schema.org -->
    <script type="application/ld+json">
        {
          "@context": "http://schema.org",
          "@type": "Person",
          "name": "Sharath",
          "jobTitle": "Data Engineer & Backend Developer",
          "description": "Data Engineer & Backend Developer specializing in Python, SQL, and data engineering.",
          "email": "dsharath217@gmail.com",
          "url": ["https://sharath.dev", "https://github.com/Sharu2172"],
          "sameAs": ["https://github.com/Sharu2172"]
        }
    </script>
  </head>
  <body>
    <div id="home" class="bg-black antialiased selection:bg-red-600 selection:text-white min-h-screen">
      <div class="mx-auto w-full max-w-6xl px-4 sm:px-1">
        <main role="main" class="relative z-10 pt-24 sm:pt-36 md:pt-14 text-base sm:text-lg text-gray-100 space-y-12 sm:space-y-16">
          <slot />
          <Footer />
        </main>
      </div>
      <GradientBackground client:only="react"/>
    </div>
  </body>
</html>